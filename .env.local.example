# ════════════════════════════════════════════════════════════════
#  RESCUEN — Environment variables
#  Copy this file to  ".env.local"  and fill in your real values.
#  (.env.local is git-ignored, so your secrets are never committed.)
#
#  Windows PowerShell:   Copy-Item .env.local.example .env.local
#  After editing, restart the dev server (npm run dev).
# ════════════════════════════════════════════════════════════════


# ─── 1) FIREBASE (Phone OTP login) ──────────────────────────────
# These NEXT_PUBLIC_ values are the *web* config and are safe in the browser.
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK config.
# Also enable: Authentication → Sign-in method → Phone (needs the Blaze plan) and Google (free), and add your domain
# (localhost is allowed by default) under Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ─── 3) GMAIL (Contact form + Automated Daan Receipt emails) ────
# Use a Gmail *App Password* (NOT your normal password).
# Google Account → Security → turn on 2-Step Verification →
# "App passwords" → create one for "Mail". Paste the 16 characters (no spaces).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# Where enquiry & donation notifications should land (optional; defaults to GMAIL_USER):
CONTACT_TO=youraddress@gmail.com


# ─── 4) RESCUEN AI ──────────────────────────────────────────────
# A key from https://aistudio.google.com/apikey . KEEP SECRET.
# Optional extra keys are tried if the first one is busy or out of credit.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Optional preferred model. Leave empty to use the newest free-friendly one.
GEMINI_MODEL=


# ─── 5) PAYMENTS (Razorpay) ─────────────────────────────────────
# https://dashboard.razorpay.com > Account & Settings > API keys. KEEP THE SECRET PRIVATE.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, and recommended: sends the receipt even when a supporter closes the tab.
# Dashboard > Webhooks > Add: URL https://<your site>/api/razorpay-webhook,
# event "payment.captured", and any long random text as the secret. Paste the same text here.
RAZORPAY_WEBHOOK_SECRET=


# ─── 6) PUBLIC LINKS (optional overrides) ───────────────────────
# Your custom domain (once connected), app store link and public support email.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.officialrescuen.app
NEXT_PUBLIC_APP_STORE_URL_IOS=https://apps.apple.com/app/rescuen
NEXT_PUBLIC_SUPPORT_EMAIL=rescuensupport@gmail.com
