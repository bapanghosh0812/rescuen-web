# ════════════════════════════════════════════════════════════════
#  RESCUEN — Environment variables
#  Copy this file to  ".env.local"  and fill in your real values.
#  (.env.local is git-ignored, so your secrets are never committed.)
#
#  Windows PowerShell:   Copy-Item .env.local.example .env.local
#  After editing, restart the dev server (npm run dev).
# ════════════════════════════════════════════════════════════════


# ─── 1) FIREBASE (Phone OTP login) ──────────────────────────────
# These NEXT_PUBLIC_ values are the *web* config and are safe in the browser.
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK config.
# Also enable: Authentication → Sign-in method → Phone, and add your domain
# (localhost is allowed by default) under Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ─── 2) FIREBASE ADMIN (server-side token verification) ─────────
# OPTIONAL but recommended. Firebase Console → Project settings →
# Service accounts → "Generate new private key" (downloads a JSON file).
# Copy the three values from that JSON here. KEEP THESE SECRET.
# For the private key, paste it in quotes on one line with \n for newlines.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"


# ─── 3) GMAIL (Contact form emails + auto-reply) ────────────────
# Use a Gmail *App Password* (NOT your normal password).
# Google Account → Security → turn on 2-Step Verification →
# "App passwords" → create one for "Mail". Paste the 16 characters (no spaces).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# Where enquiry emails should land (optional; defaults to GMAIL_USER):
CONTACT_TO=youraddress@gmail.com


# ─── 4) GEMINI AI (AI Safety Companion) ─────────────────────────
# Get a key at https://aistudio.google.com/apikey . KEEP SECRET.
GEMINI_API_KEY=


# ─── 5) PUBLIC LINKS (optional overrides) ───────────────────────
# Your real app store links + public support email shown on the site.
NEXT_PUBLIC_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.rescuen.app
NEXT_PUBLIC_APP_STORE_URL_IOS=https://apps.apple.com/app/rescuen
NEXT_PUBLIC_SUPPORT_EMAIL=support@rescuen.app
